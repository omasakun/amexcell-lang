import {
  num,
  str,
  op,
  cells_ref,
  var_ref,
  range_nonneg,
  port_ref,
  arr,
  bracketLazy,
  fn_callLazy,
  formulaLazy,
  sourceLazy
} from "./grammar";

describe("grammar", () => {
  it("num", () => {
    expect(num("0")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "num",
          "v": "0",
        },
      }
    `);
    expect(num("-0")).toMatchInlineSnapshot(`null`);
    expect(num("-042")).toMatchInlineSnapshot(`null`);
    expect(num("042")).toMatchInlineSnapshot(`
      Object {
        "t": "42",
        "v": Object {
          "_": "num",
          "v": "0",
        },
      }
    `); // FIXME: 疑惑の判定
    expect(num("-42")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "num",
          "v": "-42",
        },
      }
    `);
    expect(num("42")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "num",
          "v": "42",
        },
      }
    `);
    expect(num("0.01")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "num",
          "v": "0.01",
        },
      }
    `);
    expect(num("42.00")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "num",
          "v": "42.00",
        },
      }
    `);
    expect(num("42..2")).toMatchInlineSnapshot(`
      Object {
        "t": "..2",
        "v": Object {
          "_": "num",
          "v": "42",
        },
      }
    `);
  });
  it("str", () => {
    expect(str('"foo')).toMatchInlineSnapshot(`null`);
    expect(str('"foo"bar')).toMatchInlineSnapshot(`
      Object {
        "t": "bar",
        "v": Object {
          "_": "str",
          "v": "foo",
        },
      }
    `);
    expect(str('"""bar')).toMatchInlineSnapshot(`
      Object {
        "t": "\\"bar",
        "v": Object {
          "_": "str",
          "v": "",
        },
      }
    `); // バグの温床になりそう
    expect(str('""""bar')).toMatchInlineSnapshot(`
      Object {
        "t": "bar",
        "v": Object {
          "_": "str",
          "v": "\\"",
        },
      }
    `);
    expect(str('""""""bar')).toMatchInlineSnapshot(`
      Object {
        "t": "bar",
        "v": Object {
          "_": "str",
          "v": "\\"\\"",
        },
      }
    `);
    expect(str('""')).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "str",
          "v": "",
        },
      }
    `);
    expect(str('"foo""bar"baz')).toMatchInlineSnapshot(`
      Object {
        "t": "baz",
        "v": Object {
          "_": "str",
          "v": "foo\\"bar",
        },
      }
    `);
  });
  it("op", () => {
    expect(op("^foo")).toMatchInlineSnapshot(`
      Object {
        "t": "foo",
        "v": Object {
          "_": "op",
          "v": "^",
        },
      }
    `);
    expect(op("*foo")).toMatchInlineSnapshot(`
      Object {
        "t": "foo",
        "v": Object {
          "_": "op",
          "v": "*",
        },
      }
    `);
    expect(op("<>foo")).toMatchInlineSnapshot(`
      Object {
        "t": ">foo",
        "v": Object {
          "_": "op",
          "v": "<",
        },
      }
    `);
    expect(op("-foo")).toMatchInlineSnapshot(`
      Object {
        "t": "foo",
        "v": Object {
          "_": "op",
          "v": "-",
        },
      }
    `);
  });
  it("cell_ref", () => {
    expect(cells_ref("@aB42foo")).toMatchInlineSnapshot(`
      Object {
        "t": "foo",
        "v": Object {
          "_": "cells_ref",
          "v": Array [
            Object {
              "_": "cell",
              "v": Array [
                28,
                42,
              ],
            },
            Object {
              "_": "cell",
              "v": Array [
                28,
                42,
              ],
            },
          ],
        },
      }
    `);
    expect(cells_ref("@a0")).toMatchInlineSnapshot(`null`);
    expect(cells_ref("@c10")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "cells_ref",
          "v": Array [
            Object {
              "_": "cell",
              "v": Array [
                3,
                10,
              ],
            },
            Object {
              "_": "cell",
              "v": Array [
                3,
                10,
              ],
            },
          ],
        },
      }
    `);
    expect(cells_ref("@ab42:a1")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "cells_ref",
          "v": Array [
            Object {
              "_": "cell",
              "v": Array [
                28,
                42,
              ],
            },
            Object {
              "_": "cell",
              "v": Array [
                1,
                1,
              ],
            },
          ],
        },
      }
    `);
  });
  it("range_nonneg", () => {
    expect(range_nonneg("13..42")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Array [
          13,
          42,
        ],
      }
    `);
    expect(range_nonneg("1 .. 2")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Array [
          1,
          2,
        ],
      }
    `);
    expect(range_nonneg("0 .. 0")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Array [
          0,
          0,
        ],
      }
    `);
  });
  it("var_ref", () => {
    expect(var_ref("foo")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "var_ref",
          "v": Array [
            "foo",
            Array [],
          ],
        },
      }
    `);
    expect(var_ref("foo[x:12y:34]")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "var_ref",
          "v": Array [
            "foo",
            Array [
              Object {
                "prop": "x",
                "v": Array [
                  12,
                  12,
                ],
              },
              Object {
                "prop": "y",
                "v": Array [
                  34,
                  34,
                ],
              },
            ],
          ],
        },
      }
    `);
    expect(var_ref("foo [ x : 12 y : 34 ] ")).toMatchInlineSnapshot(`
      Object {
        "t": " ",
        "v": Object {
          "_": "var_ref",
          "v": Array [
            "foo",
            Array [
              Object {
                "prop": "x",
                "v": Array [
                  12,
                  12,
                ],
              },
              Object {
                "prop": "y",
                "v": Array [
                  34,
                  34,
                ],
              },
            ],
          ],
        },
      }
    `);
    expect(var_ref("foo[x:1..42 x:3..54]")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "var_ref",
          "v": Array [
            "foo",
            Array [
              Object {
                "prop": "x",
                "v": Array [
                  1,
                  42,
                ],
              },
              Object {
                "prop": "x",
                "v": Array [
                  3,
                  54,
                ],
              },
            ],
          ],
        },
      }
		`);
    expect(var_ref("foo[w:12h:34]")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "var_ref",
          "v": Array [
            "foo",
            Array [
              Object {
                "prop": "w",
                "v": Array [
                  12,
                  12,
                ],
              },
              Object {
                "prop": "h",
                "v": Array [
                  34,
                  34,
                ],
              },
            ],
          ],
        },
      }
    `); // FIXME:厳密にしたい。
  });
  it("port_ref", () => {
    expect(port_ref("foo.bar+42")).toMatchInlineSnapshot(`
      Object {
        "t": "+42",
        "v": Object {
          "_": "port_ref",
          "v": Array [
            "foo",
            Array [
              "bar",
              Array [],
            ],
          ],
        },
      }
    `);
    expect(port_ref("___.bar.buz")).toMatchInlineSnapshot(`
      Object {
        "t": ".buz",
        "v": Object {
          "_": "port_ref",
          "v": Array [
            "___",
            Array [
              "bar",
              Array [],
            ],
          ],
        },
      }
    `);
  });
  it("arr", () => {
    expect(arr("{}")).toMatchInlineSnapshot(`null`);
    expect(arr("{42,23;0}")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "arr",
          "v": Array [
            Object {
              "_": "num",
              "v": "42",
            },
            ",",
            Object {
              "_": "num",
              "v": "23",
            },
            ";",
            Object {
              "_": "num",
              "v": "0",
            },
          ],
        },
      }
    `);
    expect(arr("{ 42 , 23 ; 0 }")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "arr",
          "v": Array [
            Object {
              "_": "num",
              "v": "42",
            },
            ",",
            Object {
              "_": "num",
              "v": "23",
            },
            ";",
            Object {
              "_": "num",
              "v": "0",
            },
          ],
        },
      }
    `);
    expect(arr("{42,}")).toMatchInlineSnapshot(`null`);
  });
  it("bracket", () => {
    expect(bracketLazy()("()")).toMatchInlineSnapshot(`null`);
    expect(bracketLazy()("(42)")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "bracket",
          "v": Object {
            "_": "formula",
            "v": Array [
              Object {
                "_": "term",
                "v": Object {
                  "_": "num",
                  "v": "42",
                },
              },
              Array [],
            ],
          },
        },
      }
    `);
    expect(bracketLazy()("(1+2)")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "bracket",
          "v": Object {
            "_": "formula",
            "v": Array [
              Object {
                "_": "term",
                "v": Object {
                  "_": "num",
                  "v": "1",
                },
              },
              Array [
                Array [
                  Object {
                    "_": "op",
                    "v": "+",
                  },
                  Object {
                    "_": "term",
                    "v": Object {
                      "_": "num",
                      "v": "2",
                    },
                  },
                ],
              ],
            ],
          },
        },
      }
    `);
    expect(bracketLazy()("( 1 + 2 )")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "bracket",
          "v": Object {
            "_": "formula",
            "v": Array [
              Object {
                "_": "term",
                "v": Object {
                  "_": "num",
                  "v": "1",
                },
              },
              Array [
                Array [
                  Object {
                    "_": "op",
                    "v": "+",
                  },
                  Object {
                    "_": "term",
                    "v": Object {
                      "_": "num",
                      "v": "2",
                    },
                  },
                ],
              ],
            ],
          },
        },
      }
    `);
  });
  it("fn_call", () => {
    expect(fn_callLazy()("sum(1,2)")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "fn_call",
          "v": Object {
            "args": Array [
              Object {
                "_": "formula",
                "v": Array [
                  Object {
                    "_": "term",
                    "v": Object {
                      "_": "num",
                      "v": "1",
                    },
                  },
                  Array [],
                ],
              },
              Object {
                "_": "formula",
                "v": Array [
                  Object {
                    "_": "term",
                    "v": Object {
                      "_": "num",
                      "v": "2",
                    },
                  },
                  Array [],
                ],
              },
            ],
            "name": "sum",
          },
        },
      }
    `);
    expect(fn_callLazy()("sum()")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "fn_call",
          "v": Object {
            "args": Array [],
            "name": "sum",
          },
        },
      }
    `);
    expect(fn_callLazy()("sum.dest()")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "fn_call",
          "v": Object {
            "args": Array [],
            "name": "sum.dest",
          },
        },
      }
    `);
    expect(fn_callLazy()("sum ( 1 , 2 )")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "fn_call",
          "v": Object {
            "args": Array [
              Object {
                "_": "formula",
                "v": Array [
                  Object {
                    "_": "term",
                    "v": Object {
                      "_": "num",
                      "v": "1",
                    },
                  },
                  Array [],
                ],
              },
              Object {
                "_": "formula",
                "v": Array [
                  Object {
                    "_": "term",
                    "v": Object {
                      "_": "num",
                      "v": "2",
                    },
                  },
                  Array [],
                ],
              },
            ],
            "name": "sum",
          },
        },
      }
    `);
  });
  it("formula", () => {
    expect(formulaLazy()("40 + 2 * 3")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": Object {
          "_": "formula",
          "v": Array [
            Object {
              "_": "term",
              "v": Object {
                "_": "num",
                "v": "40",
              },
            },
            Array [
              Array [
                Object {
                  "_": "op",
                  "v": "+",
                },
                Object {
                  "_": "term",
                  "v": Object {
                    "_": "num",
                    "v": "2",
                  },
                },
              ],
              Array [
                Object {
                  "_": "op",
                  "v": "*",
                },
                Object {
                  "_": "term",
                  "v": Object {
                    "_": "num",
                    "v": "3",
                  },
                },
              ],
            ],
          ],
        },
      }
    `);
  });
  it("source", () => {
    expect(sourceLazy()("//foo\nbar\nb/u//z\nmoge")).toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": " bar
      b/u moge",
      }
    `);
    expect(sourceLazy()("/*foo/*bar*/buz//piyo*/\nfuga*/hoge"))
      .toMatchInlineSnapshot(`
      Object {
        "t": "",
        "v": " buz fuga*/hoge",
      }
    `);
  });
});
