// grammar.ts による解析結果の整形とか､エクセルのxml形式への変換とか
// いまになっておもったこと: パースと一緒にAST構築までやればよかった。
import {
	num,
	str,
	op,
	cells_ref,
	var_ref,
	range_nonneg,
	port_ref,
	arr,
	bracketLazy,
	fn_callLazy,
	formulaLazy,
	sourceLazy,
	root
} from "./grammar";

const err_parse_stopped = detail => {
	throw {
		message: "Error. パーサーが、すべての入力を読み込むことなく､途中で止まった。\ndetail: 解析結果",
		detail
	};
}

// FIXME:文字列リテラルの中にある\\とか\*とかでもコメントが始まるという問題。まぁ、神経衰弱を作る程度なら気にならないので後で実装する。
function stripComments(s: string) {
	const result = sourceLazy()(s);
	if (result.t != "") err_parse_stopped(result);
	return result.v;
}

type AST1 = ReturnType<typeof root>["v"];

function source2ast(s: string): AST1 {
	const result = root(s);
	if (result.t != "") err_parse_stopped(result);
	return result.v;
}

/** Literal */
interface Range { from: number, to: number }
type Op = string
interface Lit { _: "lit", raw: string }
interface Arr { _: "arr", head: Lit, tail: ["," | ";", Lit][] }
interface VarRef { _: "var_ref", name: string, x: Range, y: Range }
interface PortRef { _: "port_ref", module: string, port: string, x: Range, y: Range }
interface CellsRef { _: "cells_ref", x: Range, y: Range }
interface FnCall { _: "fn_call", fn: string, args: Formula[] }
interface Bracket { _: "bracket", inner: Formula }
interface Formula { _: "formula", head: Term, tail: [Op, Term][] }
type Term = Lit | Arr | VarRef | PortRef | CellsRef | FnCall | Bracket;
interface InDec { _: "in_dec", name: string, w: number, h: number }
interface OutDec { _: "out_dec", name: string, w: number, h: number }
interface TmpDec { _: "tmp_dec", name: string, w: number, h: number }
// FIXME:portへの代入 interface EqDec{_:"eq_dec",var:}

class Module1 {
	in: Map<string, CellSkelton>
	out: Map<string, CellSkelton>
	tmp: Map<string, CellSkelton>
	modules: string[]
}

