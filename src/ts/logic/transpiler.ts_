// grammar.ts による解析結果の整形とか､エクセルのxml形式への変換とか
// いまになっておもったこと: パースと一緒にAST構築までやればよかった。
import {
	num,
	str,
	op,
	cells_ref,
	var_ref,
	range_nonneg,
	port_ref,
	arr,
	bracketLazy,
	fn_callLazy,
	formulaLazy,
	sourceLazy,
	root,
	ParserInner,
	dec_eq
} from "./grammar";

const err_parse_stopped = detail => {
	throw {
		message: "Error. パーサーが、すべての入力を読み込むことなく､途中で止まった。\ndetail: 解析結果",
		detail
	};
}

// FIXME:文字列リテラルの中にある\\とか\*とかでもコメントが始まるという問題。まぁ、神経衰弱を作る程度なら気にならないので後で実装する。
export function stripComments(s: string) {
	const result = sourceLazy()(s);
	if (result.t != "") err_parse_stopped(result);
	return result.v;
}

type AST1 = ReturnType<typeof root>["v"];

export function source2ast(s: string): AST1 {
	const result = root(s);
	if (result.t != "") err_parse_stopped(result);
	return result.v;
}

interface Range { from: number, to: number }
interface VarDec { name: string, w: number, h: number }
type EqDec = ParserInner<typeof dec_eq>;
interface Module { name: string, in: VarDec[], out: VarDec[], tmp: VarDec[], eq: EqDec[], news: { varName: string, moduleName: string }[] }

export function detectModules(ast: AST1): Module[] {
	return ast.v.map(module => {
		const result: Module
			= { name: module.v.name, in: [], out: [], tmp: [], eq: [], news: [] };
		module.v.decs.forEach(dec_outer => {
			const dec = dec_outer.v;
			if (dec._ == "dec_in" || dec._ == "dec_out" || dec._ == "dec_tmp") {
				const vars: [string, { prop: string; v: [number, number] }[]][]
					= dec.v;
				vars.forEach(vari => {
					const var_name = vari[0];
					// FIXME:正しくない入力にはwarnくらい出してあげたい。
					const w = (vari[1].find(v => v.prop = "w") || { v: [1, 1] }).v[0];
					const h = (vari[1].find(v => v.prop = "h") || { v: [1, 1] }).v[0];
					const varDec: VarDec = { name: var_name, w, h };
					if (dec._ == "dec_in") result.in.push(varDec);
					if (dec._ == "dec_out") result.out.push(varDec);
					if (dec._ == "dec_tmp") result.tmp.push(varDec);
				});
			} else if (dec._ == "dec_new") {
				result.news.push({ varName: dec.v[0], moduleName: dec.v[1] });
			} else if (dec._ == "dec_eq") {
				// @ts-ignore
				dec.v.forEach(eq => result.eq.push(eq));
			}
		});
		return result;
	});
}